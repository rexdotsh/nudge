{
  "name": "nudge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "build": "vite build && vite build -c vite.sw.config.ts",
    "check": "svelte-check --tsgo-experimental-api --tsconfig src/app/tsconfig.json && tsc -p src/worker && tsc -p src/sw && tsc -p .",
    "lint": "oxlint --type-aware --deny-warnings",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "icons": "bun scripts/icons.ts",
    "deploy": "bun run build && wrangler deploy",
    "secrets": "bun scripts/secrets.ts"
  },
  "dependencies": {
    "declarative-web-push": "https://github.com/rexdotsh/declarative-web-push/releases/download/v0.1.0/declarative-web-push-0.1.0.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "bun@1.4.0"
}
